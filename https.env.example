# HTTPS for Audiobook Forge on your server. Copy this to https.env, fill in
# DOMAIN, the API key and SERVER, and save. Then, from this folder:
#
#   ./https-setup.sh --env https.env
#
# reads it and asks nothing. The key stays in a protected file on the server
# afterwards (certs/dns-credentials.ini), so clear it from here once HTTPS works.
# https.env is in .gitignore: never commit it.

# The name devices will open, like books.example.com. With Cloudflare, its
# domain must be on Cloudflare; the setup creates the DNS record pointing it at
# the server's LAN address (nothing has to be open to the internet).
DOMAIN=

# Cloudflare: My Profile > API Tokens > Create Token > "Edit zone DNS" template,
# limited to that domain's zone.
CLOUDFLARE_API_TOKEN=

# Change only if 443 is taken or you want another port.
HTTPS_PORT=443

# Cloudflare is the default. For another provider set DNS_PROVIDER to
# digitalocean, linode, dnsimple or route53, and put its key in API_KEY
# (Route 53: API_KEY is the access key ID, plus AWS_SECRET_ACCESS_KEY).
DNS_PROVIDER=cloudflare
API_KEY=
AWS_SECRET_ACCESS_KEY=

# The server to set up, when you run ./https-setup.sh from this folder
# (over SSH), like root@192.168.1.10.
SERVER=
