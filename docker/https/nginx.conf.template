# HTTPS in front of Audiobook Forge. ${DOMAIN} and ${HTTPS_SUFFIX} (":8443",
# or nothing on 443) are filled in when nginx starts; nginx's own $variables
# are left alone.
server {
    listen 80;
    server_name ${DOMAIN};
    return 301 https://$host${HTTPS_SUFFIX}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Book uploads, and finished books sent from another Forge, can be large.
    client_max_body_size 4g;

    location / {
        proxy_pass http://web:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering off;  # stream uploads straight through
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # The voice creator: whole audiobooks go up (in parts), and its progress
    # comes back as a live event stream.
    location /createvoice/ {
        proxy_pass http://web:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 1d;
        proxy_send_timeout 1h;
    }

    # Live progress for the book list: deliver each update as it happens.
    location = /api/events {
        proxy_pass http://web:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1d;
    }
}
