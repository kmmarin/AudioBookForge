# Copy to .env and change what you need. A blank value means "pick automatically".

# ---- Where things live ----
PORT=8080
# Job state. Keep on local disk; SQLite dislikes NFS/SMB.
DATA_DIR=./data
# Finished books. Point it at your Audiobookshelf library if you like.
OUTPUT_DIR=./output
# Owner of files written to OUTPUT_DIR (run `id` on the host).
PUID=1000
PGID=1000
TZ=America/New_York

# ---- Speed ----
# Each TTS worker is a process with its own model (about 1.4 GB RAM each on CPU).
# Auto: one worker per TORCH_THREADS cores, capped by available memory.
TTS_WORKERS=
# Threads per worker. Auto is 4 on CPU: total speed depends on cores, not on
# how they are split, and fewer workers use less memory.
TORCH_THREADS=
# Parallel ffmpeg encodes. Auto is half the cores.
ENCODE_WORKERS=
# Books voiced at the same time (they share the workers).
BOOK_CONCURRENCY=2
# Characters per work unit. Smaller spreads work more evenly.
UNIT_CHARS=1800

# ---- Output ----
# m4b, m4a, mp3, opus or flac. Each book can still be changed in the list.
DEFAULT_FORMAT=m4b
# AAC/MP3 bitrate. 64k mono is plenty for speech.
BITRATE=64k
# EBU R128 loudness pass: every book at the same, comfortable volume. Encoding
# takes a little longer; false skips it.
NORMALIZE=true
# abs = Author/Series/1 - Title/Title.m4b (Audiobookshelf), flat = Author - Title.m4b
OUTPUT_LAYOUT=abs

# ---- Whisper narration check ----
QA_DEFAULT=true
# Share of each chapter that gets transcribed.
QA_SAMPLE=0.25
# Flag chapters where more than this share of words differ.
QA_FLAG_WER=0.12
# tiny, base, small or medium
WHISPER_MODEL=base

# ---- Read along for audiobooks you add ----
# Add an M4B, MP3 or other audiobook and Whisper writes down its text, with the
# time of every word. On a 6-core CPU small took about 25 minutes per hour of
# audio with 3% of words wrong; base about 7 minutes with 4.5% wrong (names,
# mostly). Runs on WHISPER_DEVICE.
TRANSCRIBE_MODEL=small
# CPU threads for it. Auto is half the cores.
TRANSCRIBE_THREADS=
# Pieces decoded at once on the CPU. Lower it to save memory (8 uses about 1 GB more).
TRANSCRIBE_BATCH=8

# ---- Book details lookup ----
# Match new books online and fill in what the file didn't say: series and
# number, year, genre, description and a cover. Details in the file are kept.
METADATA_LOOKUP=true
# Searched in parallel: openlibrary, audible, google.
METADATA_SOURCES=openlibrary,audible,google
# Google Books needs a free API key (console.cloud.google.com, "Books API");
# without one it's skipped.
GOOGLE_BOOKS_API_KEY=
# Audible store for series and descriptions: com, co.uk, ca, com.au, de, fr, it, es, in, co.jp
AUDIBLE_REGION=com
# How close a match must be (0 to 1) before details are filled in.
MATCH_MIN=0.8
# Update info fills in a match this close without asking; below it, you pick.
MATCH_CLEAR=0.9

# ---- Free books ----
# "Find a free book": search Project Gutenberg's public-domain books and add one.
# Forge downloads their catalog once a week and searches it itself; a book is
# fetched only when you add it (at most 50 a day), after checking it's public
# domain in the USA. false hides the button.
GUTENBERG=true

# ---- Sending books to a server ----
# On a Forge with a GPU: the always-on Forge to send finished books to, so Read
# along works there from a phone, tablet or browser, with one place per book.
PUBLISH_URL=
# Send every book when it's finished (true), or only with Send to server.
PUBLISH_AUTO=true
# How the server reaches this Forge, so a voice change asked for there is voiced here.
PUBLIC_URL=
# The same secret on both Forges; only they can send each other books.
SHARE_TOKEN=

# ---- Voice creator ----
# Make a new voice from recordings of a narrator (minutes to a whole
# audiobook), at /createvoice. On by default where there's an NVIDIA GPU:
# deploy/wsl-deploy.sh and install.sh add docker-compose.voice.yml there, and
# skip it on machines without one. false = never.
VOICELAB=true
# Where /createvoice is passed to. Blank on the GPU PC (the voice creator next
# to Forge). On a server without a GPU, the PC's Forge, e.g.
# http://192.168.1.20:8080: the server then shows "Create a voice" too, and a
# friendly page when the PC is off. Blank on a plain Forge = feature off.
VOICELAB_URL=
# Uploads, clips and training checkpoints (several GB per voice).
VOICELAB_DATA_DIR=./voicelab-data
# cuda, or cpu (very slow; only for trying it out).
TRAIN_DEVICE=cuda
# Blank = picked from free video memory. Halved by itself after running out.
TRAIN_BATCH=
# Training runs until the voice stops getting closer to the narrator (it checks
# every 1,500 steps); this is only a safety limit (40,000 is ~11 h on a GTX 1660).
TRAIN_MAX_BATCHES=40000
# Video memory that must be free before training starts (GB).
TRAIN_MIN_FREE_GB=3.5
# Whisper model for transcribing the recordings: base, small or medium.
LAB_WHISPER_MODEL=small
# Where the recordings are heard: cuda (fast, takes turns with Forge) or cpu
# (no GPU needed, but about real time: a long book takes hours).
LAB_WHISPER_DEVICE=cuda
# Forge and the voice creator take turns on the GPU: auto, on or off.
GPU_SHARE=auto

# ---- Cloned voices (optional) ----
# Voices cloned from a short clip of a narrator with Qwen3-TTS, made in the
# voice creator. They're voiced by a clone server (docker-compose.clone.yml)
# on a machine with a big enough GPU (8 GB+ for the 1.7B model), e.g.
# http://192.168.1.30:8100. Blank = cloned voices can't speak.
CLONE_URL=
# The clone server's token (its CLONE_TOKEN). Blank = SHARE_TOKEN. With the
# clone server beside Forge, the installers make one, since its port is open.
CLONE_TOKEN=
# "Learn from the cloned voice": minutes of the narrator's sentences the cloned
# voice reads for a Piper voice to train on.
TEACH_MINUTES=180
# The clone server on this machine's GPU too, beside Forge: deploy/wsl-deploy.sh
# and install.sh add it and point CLONE_URL at it. auto = when the NVIDIA GPU has
# 12 GB or more (a smaller card would crowd Forge out); true = always with a GPU;
# false = never. It takes CLONE_GPU_SHARE of the card (0.6 when shared).
CLONE_LOCAL=auto

# ---- HTTPS (optional) ----
# Run ./https-setup.sh: it asks for a DNS name and an API key (Cloudflare,
# DigitalOcean, Linode, DNSimple or Route 53), gets a Let's Encrypt certificate
# that renews by itself, and fills these in. The key is kept in certs/, not here.
DOMAIN=
DNS_PROVIDER=cloudflare
HTTPS_PORT=443
SITE_URL=
# Optional: an address for Let's Encrypt's account (not needed).
ACME_EMAIL=
# true while testing: staging certificates don't count against Let's Encrypt's
# limits (browsers won't trust them).
ACME_STAGING=false

# ---- Build ----
# Kindle/MOBI/AZW3 and other older ebook formats, through Calibre. false makes
# the image about 700 MB smaller, without them.
INSTALL_CALIBRE=true

# ---- Testing ----
# true = tones instead of speech; tests the whole pipeline in seconds.
DEV_FAKE_TTS=false
